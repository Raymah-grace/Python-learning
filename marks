total=0
highest=0
lowest=100

for student in range(1,11):
    mark=int(input(f"enter marks for student {student}: "))

    total=total+mark
    
    if mark>highest:
        highest=mark

    if mark<lowest:
        lowest=mark

average=total/10

print("total marks", total)
print("average mark", average)
print("highest mark", highest)
print("lowest mark", lowest)